# =============================================================================
# QuantBot Python CCXT 24/7 Autonomous Bot Container
# Lightweight Python 3.11 Slim base
# =============================================================================
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1

# Install lightweight process monitor for health check validation
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install quantitative trading dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy automated trading bot script
COPY quantbot.py ./

# Healthcheck: Verify that the quantbot daemon process is running actively
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD pgrep -f quantbot.py > /dev/null || exit 1

# Start autonomous trading immediately upon container launch
CMD ["python", "-u", "quantbot.py"]
